# Local dev DB (run `./scripts/db-up.sh` to start Postgres in Docker).
# Host port is 5433 (not 5432) to avoid conflicting with other local
# Postgres instances. The container internally uses 5432.
DATABASE_URL="postgresql://nextjs_prisma_vercel_starter_with_design:nextjs_prisma_vercel_starter_with_design@localhost:5433/nextjs_prisma_vercel_starter_with_design"

# In production on Vercel, the Neon integration sets DATABASE_URL (pooled)
# AND DATABASE_URL_UNPOOLED (direct connection for migrations). Prisma config
# reads UNPOOLED for migrations, falls back to DATABASE_URL for local dev
# where there's no pooler distinction.
# DATABASE_URL_UNPOOLED=

# ─────────────────────────────────────────────────────────────
# Auth — Better-Auth
# ─────────────────────────────────────────────────────────────

# BETTER_AUTH_SECRET: required. Used to sign session cookies. Generate a
# fresh 32-byte secret for each environment with:
#   openssl rand -base64 32
# In production, store this in the Vercel dashboard (Settings → Environment
# Variables). Rotating the secret invalidates all active sessions.
BETTER_AUTH_SECRET=

# BETTER_AUTH_URL: the public origin Better-Auth uses to build callback
# URLs (OAuth round-trips, email links). Optional in local dev — defaults
# to http://localhost:3000 — but recommended in production for the
# canonical public URL (e.g. https://your-app.vercel.app). Vercel's
# VERCEL_BRANCH_URL is auto-detected by lib/auth/index.ts for previews.
# BETTER_AUTH_URL=http://localhost:3000

# NEXT_PUBLIC_BETTER_AUTH_URL: the SAME canonical origin, exposed to the
# browser. The Better-Auth React client (lib/auth/client.ts) reads this
# to know where to send sign-in/sign-up requests. Optional in local dev
# (defaults to same-origin); set on Vercel only if your client needs to
# call a different host than the page was served from.
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Email provider — see lib/email.ts for the abstraction.
#   'console' (default) — prints emails to stdout for local dev.
#   'file'              — writes emails as JSON lines to
#                          EMAIL_OUTBOX_PATH; used by the Playwright E2E
#                          suite. Dev-only; refuses to enable in
#                          NODE_ENV=production.
#   'resend' / 'postmark' — stubs that throw. Wire them in lib/email.ts
#                            against the vendor's SDK before selecting.
EMAIL_PROVIDER=console
# EMAIL_OUTBOX_PATH=/tmp/auth-test-emails.jsonl

# ─────────────────────────────────────────────────────────────
# Google OAuth — required
# ─────────────────────────────────────────────────────────────
# The "Continue with Google" button on /sign-in and /sign-up needs both.
# Obtain at:
#   Google Cloud Console → APIs & Services → Credentials
#     → Create Credentials → OAuth 2.0 Client ID → Web application
# Authorized redirect URI to register at Google for each environment:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   (local dev: http://localhost:3000/api/auth/callback/google)
#   (production: https://your-app.vercel.app/api/auth/callback/google)
#   (preview: https://your-app-git-<branch>-<team>.vercel.app/api/auth/callback/google
#    — preview URLs are per-PR, so wildcard-friendly registration helps)
# Missing values throw at module-load time so misconfiguration surfaces
# loudly, not at click time.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
